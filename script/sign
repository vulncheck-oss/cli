#!/bin/bash
# usage: script/sign <file>...
#
# Signs macOS binaries using codesign, notarizes macOS zip archives using notarytool, and signs
# Windows EXE and MSI files using osslsigncode.
#
# Set REQUIRE_SIGNING=1 to turn "credentials missing" from a skip into an error. CI sets this so
# that a missing secret fails the release rather than silently shipping unsigned binaries.
#
set -e

# RFC3161 timestamp authorities, tried in order until one returns a token.
#
# Without a countersignature, Authenticode validates the signing certificate against the current
# time rather than the signing time, so the signature stops being trusted the moment the
# certificate expires. Timestamping cannot be self-hosted: Windows only honours a token whose TSA
# certificate carries the Time Stamping EKU and chains to a root in the Microsoft Trusted Root
# Program, so it has to come from a publicly trusted authority.
#
# GlobalSign is first because it issued our signing certificate — using their TSA introduces no
# trust relationship we do not already depend on. The rest are fallbacks for an outage, since a
# single authority would otherwise be able to block a release on its own. A TSA only ever receives
# a hash of the signature, never the key or the binary.
#
# Set TIMESTAMP_URL to pin a single authority, or TIMESTAMP_URLS to override the whole list.
TIMESTAMP_URLS="${TIMESTAMP_URLS:-${TIMESTAMP_URL:-http://timestamp.globalsign.com/tsa/r6advanced1 http://timestamp.digicert.com http://timestamp.sectigo.com}}"

has_timestamp() {
  osslsigncode verify "$1" 2>&1 | grep -q "^Timestamp: "
}

missing_creds() {
  if [ "${REQUIRE_SIGNING:-}" = "1" ]; then
    echo "error: $1 (REQUIRE_SIGNING=1)" >&2
    return 1
  fi
  echo "skipping $1" >&2
  return 0
}

sign_windows() {
  if [ -z "$CERT_FILE" ]; then
    missing_creds "Windows code-signing; CERT_FILE not set"
    return $?
  fi

  if [ ! -f "$CERT_FILE" ]; then
    echo "error Windows code-signing; file '$CERT_FILE' not found" >&2
    return 1
  fi

  if [ -z "$KEY_FILE" ]; then
    echo "error Windows code-signing; no value for KEY_FILE" >&2
    return 1
  fi

  # An expired certificate still produces a signature, but Windows will not trust it. Fail loudly
  # instead of shipping a binary that SmartScreen treats as unsigned.
  if ! openssl x509 -in "$CERT_FILE" -noout -checkend 0 >/dev/null 2>&1; then
    echo "error Windows code-signing; certificate '$CERT_FILE' has expired:" >&2
    openssl x509 -in "$CERT_FILE" -noout -dates >&2 || true
    return 1
  fi

  # Each attempt is only accepted once the timestamp is confirmed present in the output, so a TSA
  # that answers but returns no usable token falls through to the next one rather than yielding a
  # signature that dies with the certificate.
  local url signed=0
  for url in $TIMESTAMP_URLS; do
    echo "Signing $1 (timestamp authority: $url)"
    if osslsigncode sign -n "VulnCheck CLI" \
      -certs "$CERT_FILE" -key "$KEY_FILE" \
      -ts "$url" \
      -in "$1" -out "$1"~ && has_timestamp "$1"~; then
      signed=1
      break
    fi
    echo "warning: timestamp authority unusable, trying next: $url" >&2
    rm -f "$1"~
  done

  if [ "$signed" -ne 1 ]; then
    echo "error Windows code-signing; no timestamp authority succeeded for '$1'" >&2
    echo "  tried: $TIMESTAMP_URLS" >&2
    return 1
  fi

  mv "$1"~ "$1"
}

sign_macos() {
  if [ -z "$APPLE_DEVELOPER_ID" ]; then
    missing_creds "macOS code-signing; APPLE_DEVELOPER_ID not set"
    return $?
  fi

  if [[ $1 == *.zip ]]; then
    echo "Running notarytool submit for $1"
    echo "Apple ID: ${APPLE_ID?}"
    echo "Team ID: ${APPLE_DEVELOPER_ID?}"

    # --wait blocks until Apple reaches a verdict. Without it, notarytool returns as soon as the
    # upload finishes, which is why the outcome previously had to be checked by hand.
    local json status id
    json="$(xcrun notarytool submit "$1" \
      --apple-id "${APPLE_ID?}" \
      --team-id "${APPLE_DEVELOPER_ID?}" \
      --password "${APPLE_ID_PASSWORD?}" \
      --wait --timeout 30m --output-format json)"
    echo "$json"

    status="$(printf '%s' "$json" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
    if [ "$status" != "Accepted" ]; then
      echo "error: notarization of '$1' finished with status '${status:-unknown}'" >&2
      id="$(printf '%s' "$json" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')"
      if [ -n "$id" ]; then
        echo "--- notarization log ---" >&2
        xcrun notarytool log "$id" \
          --apple-id "${APPLE_ID?}" \
          --team-id "${APPLE_DEVELOPER_ID?}" \
          --password "${APPLE_ID_PASSWORD?}" >&2 || true
      fi
      return 1
    fi
    echo "Notarization accepted for $1"
  else
    echo "Running codesign for $1"
    echo "Using Developer ID: ${APPLE_DEVELOPER_ID?}"
    codesign --timestamp --options=runtime -s "${APPLE_DEVELOPER_ID?}" -v "$1"
  fi
}

if [ $# -eq 0 ]; then
  echo "usage: script/sign <file>" >&2
  exit 1
fi

platform="$(uname -s)"

for input_file; do
  case "$input_file" in
  *.exe | *.msi )
    sign_windows "$input_file"
    ;;
  * )
    if [ "$platform" = "Darwin" ]; then
      sign_macos "$input_file"
    else
      printf "warning: don't know how to sign %s on %s\n" "$input_file" "$platform" >&2
    fi
    ;;
  esac
done
